# ==== Telegram ====
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# ==== LLM-провайдер ====
# openrouter — https://openrouter.ai (модели с суффиксом :free — бесплатные)
# groq       — https://console.groq.com | anthropic — https://console.anthropic.com
# none       — без LLM: веб-поиск + экстрактивная выжимка (бесплатно, без ключей)
LLM_PROVIDER=openrouter
LLM_API_KEY=sk-or-...

# Модель на каждую роль (меняется без правки кода).
# Платная альтернатива посильнее: qwen/qwen3-235b-a22b-2507
MODEL_MANAGER=nvidia/nemotron-3-ultra-550b-a55b:free
MODEL_ANALYST=nvidia/nemotron-3-super-120b-a12b:free
MODEL_DEVELOPER=poolside/laguna-m.1:free
MODEL_REVIEWER=nvidia/nemotron-3-ultra-550b-a55b:free

# ==== Инфраструктура (менять не нужно) ====
REDIS_URL=redis://redis:6379/0
EVENTS_STREAM=machinarium:events
WORKSPACE_DIR=/app/workspace
# База ссылок на созданные файлы в отчёте Telegram
FILES_BASE_URL=http://localhost:8080/files
